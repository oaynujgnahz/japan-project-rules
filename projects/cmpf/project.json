{
  "name": "cmpf",
  "_doc": {
    "name": "Project config read by install.sh and tools/*. One file per project: projects/<name>/project.json; keys starting with _ are docs, readers must skip them; JSON object keys are strings (e.g. layout row 5)",
    "local_only": "copied but hidden via .git/info/exclude, never committed",
    "env_checks": "install.sh step 4; empty list = skip"
  },
  "detect": {
    "_doc": {
      "_": "install.sh: warn if target does not match"
    },
    "file": "pom.xml",
    "contains": "carbon-parent"
  },
  "local_only": [
    "AGENTS.md",
    ".cursor/",
    ".github/pull_request_template.md",
    "docs/",
    "e2e/",
    "scripts/",
    "mvn8"
  ],
  "executable": [
    "mvn8",
    ".cursor/hooks/check-no-chinese-comments.py"
  ],
  "env_checks": [
    {
      "name": "java8",
      "cmd": "./mvn8 -v",
      "expect": "1.8"
    },
    {
      "name": "node",
      "cmd": "node -v",
      "expect": "v16.14.0"
    }
  ],
  "build": {
    "backend_test": "./mvn8 -pl <module> -am test -DskipTests=false",
    "frontend": "cd frontend && npm run build"
  },
  "code_comments": {
    "_doc": {
      "forbid_chinese": "enables .cursor/hooks/check-no-chinese-comments.py"
    },
    "forbid_chinese": true
  },
  "i18n": {
    "locale_dir": "frontend/src/locale",
    "languages": [
      "ja",
      "en"
    ]
  },
  "ids": {
    "_doc": {
      "external_xlsx_hide": "Q numbers never appear in client-facing xlsx",
      "error_code": "regex"
    },
    "prefixes": [
      "SCR",
      "API",
      "BR",
      "AC",
      "Q",
      "BL",
      "F"
    ],
    "external_xlsx_hide": [
      "Q"
    ],
    "error_code": "CMPF\\d{4}-[EIW]"
  },
  "ledger_dir": "/home/box/cmpf-ledger",
  "design": {
    "_doc": {
      "doc_root": "docs/{機能}/v{版本}_{日期}/",
      "layout": "TODO(设计书): sheet names / row anchors now hard-coded in export_scr.py:14, export_api.py:13"
    },
    "doc_root": "docs",
    "screen_template": "tools/design-xlsx/templates/画面設計書_模板.xlsx",
    "api_template": "tools/design-xlsx/templates/API設計書_模板.xlsx",
    "glossary": "docs/ai-native/用語辞書_日英.md",
    "layout": {}
  },
  "unit_test": {
    "_doc": {
      "_note": "以 _ 开头的键是说明，脚本读取时跳过。行号均指 tools/unit-test-xlsx/scripts/gen_ut_xlsx.py（commit 1377fc8）。",
      "template": "模板文件名 :41；探索顺序 :43（--template > 本工具 templates/ > 项目仓库 docs/ai-native/）。第二候补 docs/ai-native/単体テスト項目_テンプレート.xlsx 只在此说明，不另开键。",
      "_shared_keys": "locale 目录和语言用顶层 i18n.locale_dir / i18n.languages；错误码格式用顶层 ids.error_code（CMPF\\d{4}-[EIW]）；台账目录用顶层 ledger_dir；追溯 ID 前缀用顶层 ids.prefixes。此处不重复。",
      "locale_files": "locale 文件名候选 :118-119（ja :118，en :119）。脚本 :46 还会搜索 frontend/locale（第二候补目录），i18n 目前只写了第一候补。",
      "_error_code_diff": "脚本 :63、:117、:126 写死的是更宽的 [A-Z]{2,8}\\d{3,5}-[EIW]；改读 ids.error_code 后非 CMPF 前缀不再算错误码，其他项目需在自己的配置里填前缀。",
      "trace_id_regex": "当前脚本正则 :64-65（TRACE_RE 实际只用 BR/AC/Q），尚未改读配置。",
      "viewpoints": "試験観点 16 词，取自 VIEWPOINTS :48-53。",
      "viewpoints_required": "模板 試験観点 sheet 中 対象=〇 的默认必覆盖项（模板第 3、4、5、7、8、9、10、16 行）。脚本目前没有对应常量。",
      "display_types": "表示タイプ :54（定义 :48）。",
      "align": "詰め方 :55。",
      "body_lang": "正文语言 :59-60（meta.lang=ja 时用 ZH_ONLY 检出简体中文混入）。",
      "ledger_file_pattern": "各功能一个文件，表头为 ID / 问题 / 决定 / 决定日 / 来源。不在 gen_ut_xlsx.py 中。",
      "error_message_templates": "错误码 Case 文言展开 :143, :157-167；ja :158（branch2=日本語），en :167（観点=多言語対応チェック，branch2=英語）。",
      "sheets": "6 个 sheet 的 XML 位置、名称与顺序 :83-86, :678-683。files.viewpoints / files.db_write 属 FIXED_FILES :86（試験観点字节不可变；DB書き込み判定保持隐藏、不放 Case）；summary/layout :84；operation/check :85；names_in_order :679；hidden :683。",
      "styles": "各 sheet 样式 ID（模板 styles.xml 的 cellXfs 编号）:71-81，换模板必须重取。layout_section :72；layout :73-76（列 A〜AA）；operation_section :77（分组行左对齐，旧 helper 用 55 会居中截断）；operation :78-79（列 A〜L）；check :80-81（列 A〜K）。",
      "layout": "画面レイアウト判定 :467-509。header_rows :467,:470；case_start_row :467,:472；legend_rows :467,:471（生成时整块挪到最后一条 Case 之后）；display_type_list_rows :467,:498（表示タイプ一覧 TT〜LNK）；模板既有下拉公式范围 $A$46:$A$56（:506 用以定位），生成后改写成含第 57 行 LNK 的新位置；result_col :505,:592,:692。",
      "operation": "画面操作処理判定 :512-542, :685-686。header_rows :512,:515；case_start_row :519；result_col :512,:592,:692；header :685-686。",
      "check": "項目チェック判定 :550-583。result_col :550,:581,:592,:692。",
      "summary": "項目総計 元数据格 :586-589 与 COUNTIF 行 :586,:592,:692；total_row :586,:600-601。case_count_rows 的键是行号（JSON 键只能是字符串）。",
      "named_ranges": "_FilterDatabase / Print_Area 列范围 :605-614（layout :609，operation :610，check :611-614）。"
    },
    "template": "tools/unit-test-xlsx/templates/単体テスト項目_テンプレート.xlsx",
    "locale_files": {
      "ja": [
        "ja_index.ts",
        "ja/index.ts"
      ],
      "en": [
        "en_message.ts",
        "en/message.ts",
        "en/index.ts"
      ]
    },
    "trace_id_regex": "(?<![\\w-])(?:BR|AC|Q)-(?:[A-Z]{1,6}-)?\\d{1,3}(?![\\w-])",
